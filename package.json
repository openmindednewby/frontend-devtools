{
  "name": "@dloizides/frontend-devtools",
  "version": "2.1.0",
  "description": "Shared RN-web dev tooling (dev-only) for the dloizides.com SaaS frontends: the custom ESLint plugin pack and rule packs (/eslint) and the test-results reporters (/test-results). initI18n moved to @dloizides/i18n in 2.0.0. Never imports a product.",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "react-native",
    "dev-tooling",
    "dloizides"
  ],
  "author": "dloizides",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openmindednewby/frontend-devtools.git"
  },
  "homepage": "https://github.com/openmindednewby/frontend-devtools#readme",
  "bugs": {
    "url": "https://github.com/openmindednewby/frontend-devtools/issues"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./eslint": {
      "require": {
        "types": "./dist/eslint/index.d.ts",
        "default": "./dist/eslint/index.js"
      },
      "import": {
        "types": "./dist/eslint/index.d.mts",
        "default": "./dist/eslint/index.mjs"
      }
    },
    "./test-results": {
      "require": {
        "types": "./dist/test-results/index.d.ts",
        "default": "./dist/test-results/index.js"
      },
      "import": {
        "types": "./dist/test-results/index.d.mts",
        "default": "./dist/test-results/index.mjs"
      }
    },
    "./test-results/jest-reporter": {
      "require": {
        "types": "./dist/test-results/jestReporter.d.ts",
        "default": "./dist/test-results/jestReporter.js"
      },
      "import": {
        "types": "./dist/test-results/jestReporter.d.mts",
        "default": "./dist/test-results/jestReporter.mjs"
      }
    },
    "./test-results/vitest-reporter": {
      "require": {
        "types": "./dist/test-results/vitestReporter.d.ts",
        "default": "./dist/test-results/vitestReporter.js"
      },
      "import": {
        "types": "./dist/test-results/vitestReporter.d.mts",
        "default": "./dist/test-results/vitestReporter.mjs"
      }
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsup",
    "build:watch": "tsup --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "security:audit": "npm audit --audit-level=high",
    "deps:outdated": "npm outdated || exit 0",
    "deps:unused": "npx depcheck --ignores \"@types/jest,@types/node,rimraf,@typescript-eslint/parser\"",
    "deps:licenses": "npx license-checker --onlyAllow \"MIT;Apache-2.0;ISC;BSD-2-Clause;BSD-3-Clause;0BSD;Unlicense;CC0-1.0;CC-BY-3.0;CC-BY-4.0;Python-2.0;BlueOak-1.0.0;LGPL-3.0;LGPL-3.0-only;LGPL-3.0-or-later\"",
    "deps:health": "npm run deps:outdated && npm run deps:unused",
    "prepublishOnly": "npm run clean && npm run build && npm run test"
  },
  "peerDependencies": {
    "eslint": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/eslint": "^8.56.12",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.19.32",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.0.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@tanstack/eslint-plugin-query": "^5.104.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "eslint-plugin-sonarjs": "^4.2.2"
  }
}
